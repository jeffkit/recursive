# .env.example — copy to .env and fill in values before running docker compose
#
# Required:
RECURSIVE_API_KEY=<your-recursive-api-key>

# Optional — defaults shown:
RECURSIVE_API_BASE=https://api.openai.com/v1
RECURSIVE_MODEL=gpt-4o-mini
RECURSIVE_PROVIDER_TYPE=openai
RECURSIVE_MAX_STEPS=32
RECURSIVE_TEMPERATURE=0.2

# HTTP server
# A session is owned by the credential that created it (issue #85): every
# /sessions/:id* route is asserted against that owner, and GET /sessions is
# filtered by it. API keys that are not attributed below all share the single
# `api-key` subject — attribute them when callers must not see each other.
RECURSIVE_HTTP_AUTH_KEYS=
# `subject=key` pairs, e.g. alice=key1,bob=key2
RECURSIVE_HTTP_AUTH_KEY_OWNERS=
# Subjects with the admin role (reach every session), comma-separated.
RECURSIVE_HTTP_AUTH_ADMINS=
# HS256 secret for `Authorization: Bearer` JWTs; the `sub` claim (optionally
# scoped by a `tenant` claim) is the session owner.
RECURSIVE_HTTP_AUTH_JWT_SECRET=

# Cross-step retry (issue #100): when a step's LLM call fails with a
# transient provider error (429 / 5xx / network), the agent backs off and
# re-issues the call instead of ending the turn. Cancellation is honoured
# during the backoff. Defaults shown.
RECURSIVE_STEP_RETRY_MAX=3
RECURSIVE_STEP_RETRY_INITIAL_BACKOFF_SECS=1
RECURSIVE_STEP_RETRY_MAX_BACKOFF_SECS=30

# Cloud storage — leave blank to use local-mode defaults.
# RECURSIVE_S3_BUCKET selects the shared S3 transcript backend (requires the
# image to be built with FEATURES=http,cloud-runtime — docker compose does this).
# RECURSIVE_REDIS_URL is recognised but the HTTP server does not use a Redis
# session store yet (no per-turn checkpoint consumer).
RECURSIVE_REDIS_URL=
RECURSIVE_S3_BUCKET=
