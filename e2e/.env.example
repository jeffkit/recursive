# E2E test environment variables
# Copy to .env and fill in your keys

# Required for live integration tests (06) and LLM recording
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Required for LLM-as-judge
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-chat

# ── Recording workflow ──────────────────────────────────────────────
# Set E2E_RECORD=1 to run a suite against a real model and capture every
# LLM request/response as a fixture (aimock proxies to the real model and
# records to e2e/fixtures/recorded/). Then run e2e/scripts/promote.sh to
# merge the recording into a deterministic fixture for replay-mode CI.
# Full guide: e2e/RECORD_REPLAY.md
#
# Usage:
#   E2E_RECORD=1 argusai -c e2e.yaml run -s <suite-id>
#   ./scripts/promote.sh <suite-id>
#   argusai -c e2e.yaml run -s <suite-id>      # replay (no key needed)
E2E_RECORD=
