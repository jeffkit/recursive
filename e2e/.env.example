# E2E test environment variables
# Copy to .env and fill in your keys

# Required for live integration tests (06) and LLM recording
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Required for LLM-as-judge
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-chat

# ── Recording / replay workflow ─────────────────────────────────────
# Single entry point (MCP path): .dev/scripts/e2e-run.sh <suite-id>
#   Replay (CI, default, no key):  .dev/scripts/e2e-run.sh <suite-id>
#   Record (needs real key):       E2E_RECORD=1 DEEPSEEK_API_KEY=... \
#                                    .dev/scripts/e2e-run.sh <suite-id>
# Then merge the recording into a deterministic fixture and commit it:
#   cd e2e && ./scripts/promote.sh <suite-id>
# Full guide: e2e/RECORD_REPLAY.md
#
# aimock is owned by the e2e plugin (e2e/plugins/src/index.ts), NOT declared in
# e2e.yaml mocks. Never run `argusai -c e2e.yaml run` — the CLI 0.12.3
# yaml-engine swallows setup-step exec errors as "✓" (false green).
E2E_RECORD=
